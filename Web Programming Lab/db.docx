6. add_student.html 

<h2>Add Student</h2> 

<form method="POST"> 

    {% csrf_token %} 

    {{ form.as_p }} 

    <button type="submit">Save</button> 

</form> 

 

 

 

7. show_students.html 

<h2>Student List</h2> 

<ul> 

    {% for student in students %} 

        <li> 

            {{ student.name }} - {{ student.age }} - {{ student.grade }} 

        </li> 

    {% endfor %} 

</ul> 

<a href="/add/">Add New Student</a> 

 

 

